class Solution {
    public int maxScore(int[] cardScore, int k) {
        //your code goes here
        int n=cardScore.length;
        int left=0;
        int right=0;
        int maxsum=0;
        for(int i=0;i<k;i++){
            left+=cardScore[i];
        }
        maxsum=left;
        int rtidx=n-1;
        for(int i=k-1;i>=0;i--){
            left-=cardScore[i];
            right=right+cardScore[rtidx];
            maxsum=Math.max(maxsum,left+right);
            rtidx--;
        }
        return maxsum;
    }
}